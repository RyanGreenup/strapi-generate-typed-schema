{
  "name": "@ryangreenup/eslint-config",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.js",
    "./extensions/eslint-only": "./src/extensions/eslint-only.js",
    "./extensions/oxlint-compatible": "./src/extensions/oxlint-compatible.js",
    "./oxlint/solid": "./src/generated/oxlint-solid.js",
    "./solid": "./src/configs/solid.js"
  },
  "scripts": {
    "format": "oxfmt -c ../oxlint-config/oxfmt.json --write .",
    "generate:oxlint": "node scripts/generate-oxlint-config.mjs",
    "check-types": "tsgo --skipLibCheck --noEmit",
    "lint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ .",
    "fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix .",
    "test": "vitest run"
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "eslint-plugin-antfu": "catalog:",
    "eslint-plugin-command": "catalog:",
    "eslint-plugin-e18e": "catalog:",
    "eslint-plugin-eslint-comments": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "eslint-plugin-unused-imports": "catalog:"
  },
  "devDependencies": {
    "@oxlint/migrate": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  }
}
