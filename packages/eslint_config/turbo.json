{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // eslint-plugin-turbo reads workspace turbo.json and package.json files.
    // Explicit root globs do not honor .gitignore; omit installed dependencies.
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/**/turbo.json",
        "$TURBO_ROOT$/**/package.json",
        "!$TURBO_ROOT$/**/node_modules/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/**/turbo.json",
        "$TURBO_ROOT$/**/package.json",
        "!$TURBO_ROOT$/**/node_modules/**"
      ]
    }
  }
}
