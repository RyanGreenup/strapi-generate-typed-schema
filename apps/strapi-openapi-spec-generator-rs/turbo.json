{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Cargo only reads sources, manifests, the lockfile and the toolchain
    // file. Explicit globs keep target/ out of the hash even without .git.
    "build": {
      "inputs": [
        "crates/**/*.rs",
        "crates/*/Cargo.toml",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml"
      ],
      "outputs": ["target/release/cli"]
    },
    "check-types": {
      "inputs": [
        "crates/**/*.rs",
        "crates/*/Cargo.toml",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml"
      ]
    },
    "lint": {
      "inputs": [
        "crates/**/*.rs",
        "crates/*/Cargo.toml",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml"
      ]
    },
    "test": {
      "inputs": [
        "crates/**/*.rs",
        "crates/*/Cargo.toml",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml"
      ]
    }
  }
}
