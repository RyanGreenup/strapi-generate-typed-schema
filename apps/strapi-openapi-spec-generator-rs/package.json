{
  "name": "@ryangreenup/strapi-openapi-spec-generator-rs",
  "version": "0.1.0",
  "private": true,
  "description": "CLI to generate Strapi API OpenAPI Spec (Rust workspace)",
  "license": "MIT",
  "author": "Ryan Greenup <ryanxgreenup@gmail.com>",
  "scripts": {
    "build": "cargo build --workspace --bins --release --locked",
    "check-types": "cargo check --workspace --all-targets --locked",
    "test": "cargo test --workspace --locked",
    "lint": "cargo clippy --workspace --all-targets --locked -- -D warnings && cargo fmt --all --check",
    "format": "cargo fmt --all",
    "fix": "cargo clippy --fix --allow-dirty --allow-staged --workspace --all-targets --locked && cargo fmt --all"
  }
}
