{
  "kind": "collectionType",
  "info": { "singularName": "page", "pluralName": "pages" },
  "options": { "draftAndPublish": false, "privateAttributes": ["editorNote"] },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 5,
      "maxLength": 10
    },
    "editorNote": { "type": "text" },
    "passcode": { "type": "password" },
    "secret": { "type": "string", "private": true }
  }
}
