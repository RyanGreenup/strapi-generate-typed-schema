{
  "name": "@ryangreenup/tui-components",
  "version": "0.0.0",
  "description": "OpenTUI SolidJS component kit compiled for the universal renderer.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.bun.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:fast": "oxlint . --type-aware",
    "lint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ . && oxfmt --check .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix ."
  },
  "dependencies": {
    "fuzzysort": "catalog:",
    "opentui-spinner": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@eslint/markdown": "catalog:",
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@rollup/plugin-babel": "catalog:",
    "@ryangreenup/eslint-config": "workspace:*",
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:tui",
    "babel-plugin-module-resolver": "catalog:",
    "babel-preset-solid": "catalog:",
    "bumpp": "catalog:tui",
    "eslint": "catalog:tui",
    "eslint-plugin-antfu": "catalog:",
    "eslint-plugin-command": "catalog:tui",
    "eslint-plugin-e18e": "catalog:",
    "eslint-plugin-eslint-comments": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-jsonc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:tui",
    "eslint-plugin-pnpm": "catalog:",
    "eslint-plugin-regexp": "catalog:tui",
    "eslint-plugin-solid": "catalog:tui",
    "eslint-plugin-sonarjs": "catalog:tui",
    "eslint-plugin-toml": "catalog:",
    "eslint-plugin-turbo": "catalog:tui",
    "eslint-plugin-unused-imports": "catalog:",
    "eslint-plugin-yml": "catalog:",
    "oxfmt": "catalog:tui",
    "oxlint": "catalog:tui",
    "oxlint-tsgolint": "catalog:tui",
    "solid-js": "catalog:tui",
    "tsdown": "catalog:tui",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": "^0.5.14",
    "@opentui/keymap": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "solid-js": "^1.9.12"
  }
}
