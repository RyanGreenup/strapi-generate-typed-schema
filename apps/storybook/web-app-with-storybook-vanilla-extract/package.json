{
  "name": "@ryangreenup/strapi-openapi-spec-generator-web-app-with-storybook-vanilla-extract",
  "version": "0.0.1",
  "private": true,
  "description": "Storybook web app",
  "license": "MIT",
  "author": "Ryan Greenup <ryanxgreenup@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "serve": "vite preview",
    "check-types": "tsgo --skipLibCheck --noEmit",
    "format": "oxfmt -c node_modules/@ryangreenup/oxlint-config/oxfmt.json --write .",
    "lint": "oxlint --type-aware --type-check . && oxfmt -c node_modules/@ryangreenup/oxlint-config/oxfmt.json --check .",
    "fix": "oxlint --fix --fix-suggestions --type-aware --type-check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@vanilla-extract/recipes": "catalog:",
    "@vanilla-extract/sprinkles": "catalog:",
    "solid-devtools": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@ryangreenup/oxlint-config": "workspace:*",
    "@ryangreenup/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
